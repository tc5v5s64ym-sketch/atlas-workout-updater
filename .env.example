# Copy this file to .env for local development.
# Never commit .env or real secret values.
# Production secrets live in Render and GitHub repository settings.
# Rotate any secret that was ever committed before relying on this cleanup.

ATLAS_API_KEY=replace_me
GOOGLE_SHEETS_ID=replace_me
OPENAI_API_KEY=replace_me
GEMINI_API_KEY=replace_me
GOOGLE_SERVICE_ACCOUNT_EMAIL=replace_me
GOOGLE_PRIVATE_KEY="replace_me"
PORT=3000

# Optional: persisted training goal for the recommendation pipeline.
# Valid values: strength | hypertrophy | power | recovery | mixed |
#               conditioning_fat_loss | muscular_endurance | general_health
# Aliases (e.g. "muscle", "powerbuilding") are accepted and normalised.
# Leave unset to fall back to the pipeline default (general_health).
# ATLAS_PROFILE_GOAL=hypertrophy

# Optional: IANA timezone for "today"/recency math (daysSince, "trained
# yesterday", recent-lift exclusion). Workout dates are stamped in the owner's
# local day, so set this to the owner's zone to keep recency aligned and avoid a
# midnight off-by-one. Leave unset to use UTC (unchanged behavior).
# ATLAS_TIMEZONE=America/Los_Angeles

# Optional (F04C): server-side secret that signs the durable owner-session cookie.
# When set, the browser authenticates once per device via a signed HttpOnly,
# Secure, SameSite=Strict cookie (~120 days) instead of keeping the raw API key in
# localStorage. When UNSET, durable sessions are disabled and auth falls back to
# the x-atlas-api-key header (unchanged behavior) — so nothing breaks until it is
# provisioned. Generate a fresh random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit a real value; set it only in Render (and local .env for dev).
# ATLAS_SESSION_SECRET=replace_me_with_a_32_byte_random_hex_string
