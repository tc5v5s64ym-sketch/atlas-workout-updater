{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.development.local)",
      "Read(.env.production)",
      "Read(.env.production.local)",
      "Read(.env.staging)",
      "Read(.env.staging.local)",
      "Read(.env.test)",
      "Read(.env.test.local)",
      "Read(.env.ci)",
      "Read(.secret)",
      "Read(secrets/**)",
      "Read(service-account.json)",
      "Read(google-credentials.json)",
      "Read(credentials*.json)",
      "Read(*.key)",
      "Read(*.pem)",
      "Read(backups/**)",
      "Read(outputs/**)",
      "Read(live-retest-artifacts/**)",

      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.development)",
      "Edit(.env.development.local)",
      "Edit(.env.production)",
      "Edit(.env.production.local)",
      "Edit(.env.staging)",
      "Edit(.env.staging.local)",
      "Edit(.env.test)",
      "Edit(.env.test.local)",
      "Edit(.env.ci)",
      "Edit(.secret)",
      "Edit(secrets/**)",
      "Edit(service-account.json)",
      "Edit(google-credentials.json)",
      "Edit(credentials*.json)",
      "Edit(*.key)",
      "Edit(*.pem)",
      "Edit(backups/**)",
      "Edit(outputs/**)",
      "Edit(live-retest-artifacts/**)"
    ]
  }
}
