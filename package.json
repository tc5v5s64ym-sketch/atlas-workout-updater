{
  "name": "atlas-workout-updater",
  "version": "1.0.0",
  "description": "AI-assisted workout logging and coaching app: NL parsing, deterministic coaching engine, approve-before-write Google Sheets record",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "prestart": "npm run build",
    "dev": "vite",
    "dev:server": "node index.js",
    "build": "vite build && node scripts/write-build-info.js",
    "build:info": "node scripts/write-build-info.js",
    "lint": "eslint .",
    "atlas:status": "node scripts/atlas-status.js",
    "atlas:review-live": "node scripts/atlas-review-live.js",
    "atlas:divergence": "node scripts/atlas-divergence.js",
    "atlas:turn-write-artifact": "node scripts/atlas-turn-write-artifact.js",
    "atlas:corpus-baseline": "node scripts/corpus-baseline-runner.js",
    "atlas:sweep": "node scripts/atlas-migration-sweep.js",
    "atlas:repair": "node scripts/atlas-migration-repair.js",
    "atlas:catalog-sync": "node scripts/atlas-catalog-sync.js",
    "atlas:backfill": "node scripts/atlas-migration-backfill.js",
    "atlas:readiness": "node scripts/atlas-migration-readiness.js",
    "supabase:migrate": "node scripts/apply-supabase-migrations.js",
    "atlas:rehearsal-session": "node scripts/atlas-rehearsal-session.js",
    "check:wiring": "node scripts/check-wired-modules.js",
    "check:authority": "node scripts/check-authority-consistency.js",
    "check:banned": "node scripts/check-banned-patterns.js",
    "check:allowlist": "node scripts/check-allowlist-ratchet.js",
    "check:paper-weight": "node scripts/check-paper-weight.js",
    "check:backlog-intake": "node scripts/check-backlog-intake.js",
    "check:ladder": "node scripts/check-completion-ladder.js",
    "check:packet-trace": "node scripts/check-packet-trace.js",
    "check:supabase-safety": "node scripts/check-supabase-migration-safety.js",
    "atlas:p8b": "node scripts/atlas-p8b-checkpoint.js",
    "archive:backlog": "node scripts/archive-backlog.js",
    "check:syntax": "find . -path ./node_modules -prune -o -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node --test --test-reporter=spec",
    "test:pg": "node scripts/run-pg-proof.js",
    "pretest": "npm run build",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "scan:secrets": "node scripts/check-changed-files-for-secrets.js",
    "smoke:render": "node scripts/smoke-test-render.js",
    "backup:sheets": "node scripts/export-sheets-backup.js",
    "audit:finalized-orphans": "node scripts/atlas-audit-finalized-orphans.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.3",
    "googleapis": "^173.0.0",
    "multer": "^2.1.1",
    "openai": "^4.103.0",
    "pg": "^8.22.0",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@preact/signals-core": "^1.14.4",
    "eslint": "^10.6.0",
    "globals": "^17.7.0"
  }
}
