backups/
# Local Claude Code state stays ignored. The one exception is the shared,
# checked-in permission ruleset: .claude/settings.json (deny-only). Exclude the
# directory CONTENTS, not the directory itself — git cannot re-include a file
# inside an excluded directory.
.claude/*
!.claude/settings.json
!.claude/rules/
outputs/

# Playwright transient output (traces, screenshots on failure)
test-results/
playwright-report/

# Vite build output (PR-22): src/app/ is the committed source; public/ is
# regenerated by `npm run build` (see package.json prestart, and
# docs/ARCHITECTURE.md "Frontend build"). Never commit it.
/public/

# Live-retest harness screenshots (uploaded as CI artifacts, never committed)
live-retest-artifacts/

# Stage-A acceptance evidence — raw runs from the Phase 4 Stage-A streak (2026-08-01).
# The machinery that produced these was removed under its recorded sunset once Stage A
# reached 5/5, so nothing regenerates them — but the runs themselves are preserved locally
# and must NEVER be committed. Screenshots and full logs stay out of the repository; what
# enters it is the bounded, privacy-safe record per session under docs/verification/,
# carrying SHA-256 hashes of these files rather than the files.
canary-artifacts/
stage-a-artifacts/
rehearsal-artifacts/

# Supabase CLI local artifacts (added when the S2 -> Atlas Production owner gate
# was executed). `supabase link` writes the PROJECT REFERENCE and pooler
# connection strings into these paths, and §8.4 of
# docs/SUPABASE_HOT_PATH_MIGRATION.md treats the reference as a secret — exactly
# as the production Sheet ID is treated. The owner links inside this checkout to
# run `supabase db push`, so the protection has to be structural rather than a
# remembered instruction.
#
# NOTE: `scan:secrets` would NOT catch config.toml's bare `project_id = "<ref>"`,
# because the project-reference pattern requires the `.supabase.co` host suffix.
# That is why these are ignored rather than left to the scanner.
supabase/.temp/
supabase/.branches/
supabase/config.toml
